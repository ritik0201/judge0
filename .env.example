# Judge0 Environment Configuration Example
# Copy to .env and set secure production secrets

POSTGRES_USER=judge0
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_DB=judge0

REDIS_PASSWORD=your_secure_redis_password_here

# Port binding for Judge0 API server (Bound to localhost by default for security)
JUDGE0_HOST_BIND=127.0.0.1
JUDGE0_PORT=2358

# Optional Authentication Token between your backend and Judge0
# If empty, internal network access is unauthenticated
AUTHN_TOKEN=
